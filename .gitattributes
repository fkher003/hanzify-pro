# Chuẩn hoá line ending: dùng LF trong repo, CRLF trên Windows khi checkout
* text=auto eol=lf

# Dart/Flutter source files
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binary files — không thay đổi
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
